{
  "name": "tagmatic",
  "version": "1.1.0",
  "description": "Multi-source automated SemVer release management and tagging tool for Git repositories, container registries, and CI/CD pipelines",
  "main": "src/tagmatic.js",
  "exports": {
    ".": "./src/tagmatic.js"
  },
  "type": "module",
  "bin": {
    "tagmatic": "bin/tagmatic.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/tagmatic.js",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "tagmatic",
    "git",
    "tag",
    "semver",
    "version",
    "release",
    "generator",
    "cli",
    "docker",
    "gar",
    "gcp",
    "artifact-registry"
  ],
